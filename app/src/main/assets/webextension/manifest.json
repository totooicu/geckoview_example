{
  "manifest_version": 2,
  "name": "GeckoView Native Bridge",
  "version": "1.0.6",
  "description": "Bridge between page JS and native Android modules (BLE, files, screen capture)",
  "applications": {
    "gecko": {
      "id": "{01234567-89ab-cdef-4567-89abcdef0123}"
    }
  },
  "permissions": ["nativeMessaging"],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
